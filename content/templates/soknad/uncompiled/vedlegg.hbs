<div class='soknad-section'>
  <h3>{{section-number}}.
    {{@root.teksterUtenomSpørsmål.listeOverVedlegg}}</h3>
  {{#each dokumentasjon}}
    <div class='soknad-sporsmal-med-svar'>
      <p class='soknad-sporsmal'>
        {{erstatt @root.teksterUtenomSpørsmål.vedleggXavY antall=(add @index 1) totalAntall=dokumentasjon.length}}:
        {{dokumentasjonSpråkTittel}}
      </p>
      <p>
        {{#if harSendtInn}}
          {{@root.teksterUtenomSpørsmål.sendtInnTidligere}}
        {{else}}
          {{erstatt @root.teksterUtenomSpørsmål.lastetOppAntall antall=opplastedeVedlegg.length}}
        {{/if}}
      </p>
    </div>
  {{/each}}
</div>